<Window
    x:Class="ScrcpyReceive.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="WindowRoot" PreviewKeyDown="Root_KeyDown">
    <ContentControl x:Name="PlayerInput" IsTabStop="False"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Border x:Name="VideoContainer" Background="Black">
            <SwapChainPanel x:Name="VideoSurface"/>
        </Border>
    </ContentControl>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid x:Name="LayoutRoot" Padding="24" RowSpacing="16" MaxWidth="1280" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="ScrcpyReceive-Windows" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="MilestoneText" Text="Receiver foundation - not a playback release" FontSize="16" TextWrapping="Wrap"/>
            <TextBlock Text="Waiting for a sender..." FontSize="20" TextWrapping="Wrap"/>
        </StackPanel>
        <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Warning"
                 Title="Trusted private LAN only"
                 Message="Listening starts automatically. No encryption, authentication or pairing. Use only a trusted private network; close this app to stop listening."/>
        <InfoBar x:Name="Problem" Grid.Row="2" IsOpen="False" IsClosable="False" Severity="Error"/>
        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock x:Name="AddressesText" Text="Starting receiver..." TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="18"/>
            <TextBlock Text="During playback: Enter or F toggles fullscreen. Esc exits fullscreen." TextWrapping="Wrap"/>
        </StackPanel>
        <InfoBar x:Name="CapabilityInfo" Grid.Row="4" IsOpen="True" IsClosable="False" Severity="Informational"
                 Title="Playback not connected"
                 Message="This build validates protocol and lifecycle only. All cast requests receive UNSUPPORTED_CONFIG; no sender should capture or mute. Hardware decoding, GPU rendering, audio synchronization and SRT remain pending."/>
        <Grid Grid.Row="5" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusText" Text="Stopped" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <Expander Grid.Row="1" Header="Connection details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <ListView x:Name="Diagnostics" SelectionMode="None" Height="160">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            </Expander>
        </Grid>
    </Grid>
    </ScrollViewer>
    </Grid>
</Window>
