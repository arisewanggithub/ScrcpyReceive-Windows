<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(ReceiverRuntimeIdentifier)</RuntimeIdentifier>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</PlatformTarget>
    <Platforms>ARM64;x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableMsixTooling>false</EnableMsixTooling>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <ProjectReference Include="..\ScrcpyReceive.Core\ScrcpyReceive.Core.csproj" />
    <ProjectReference Include="..\ScrcpyReceive.Media\ScrcpyReceive.Media.csproj" />
  </ItemGroup>
  <Target Name="ValidateArchitecture" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(RuntimeIdentifier)' != 'win-arm64' And '$(RuntimeIdentifier)' != 'win-x64'"
           Text="ScrcpyReceive-Windows supports only win-arm64 and win-x64." />
    <Error Condition="('$(Platform)' == 'x64' And '$(RuntimeIdentifier)' != 'win-x64') Or ('$(Platform)' == 'ARM64' And '$(RuntimeIdentifier)' != 'win-arm64')"
           Text="Platform and RuntimeIdentifier must match." />
  </Target>
  <Target Name="PublishResources" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="WinUI resource index is missing." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
